  if (Hh.restarts > 2 || Hh.gaps > 0) A.push(['warn', 'Check soon', 'The logger had <b>' + Hh.restarts + ' restarts</b> and <b>' + Hh.gaps + ' gap' + (Hh.gaps === 1 ? '' : 's') + '</b>. Use a steady 5 V charger and check the USB cable.']);
  if (d.errors) A.push(['warn', 'Check soon', '<b>' + d.errors + ' sensor error' + (d.errors === 1 ? '' : 's') + '</b> in this window. Check that the probe cable is firmly connected.']);
