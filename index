  const slides = [];
  slides.push('<div class="slide"><p class="t">' + icon(S.inRange >= .95 ? 'shield' : 'bolt') + (S.inRange >= .95 ? 'Food safety on track' : S.aboveMin >= S.belowMin ? dur(S.aboveMin) + ' above ' + P.hi + '°' : dur(S.belowMin) + ' below ' + P.lo + '°') + '</p>' +
    '<p>' + (S.inRange >= .95 ? 'Inside ' + P.lo + ' to ' + P.hi + ' °C ' + pct(S.inRange) + ' of the time.' : 'Out of range ' + pct(1 - S.inRange) + ' of the time across ' + E.length + ' excursions. The longest lasted ' + dur(longest) + '.') + (dz && S.aboveMin > 120 ? ' That is over the common 2-hour allowance for high-risk food.' : '') + '</p><a data-jump="cardFood">View details ›</a></div>');
  slides.push('<div class="slide"><p class="t">' + icon('gauge') + (C ? 'A cycle every ' + Math.round(C.periodMin) + ' min' : 'Cycle not clear yet') + '</p>' +
