          peakV: peaks.length ? avg(peaks.map(p => p.v)) : null, troughV: troughs.length ? avg(troughs.map(p => p.v)) : null, lastExt};
}

/* logger health */
function health(pts, nowT){
  const first = pts[0].t, last = pts[pts.length - 1].t;
  let gaps = 0, longest = 0, restarts = 0;
  for (let i = 1; i < pts.length; i++){
    const d = pts[i].t - pts[i-1].t;
    if (d > GAP_MS){ gaps++; longest = Math.max(longest, d); }
    if (d < 60000) restarts++;
  }
  const span = Math.max(last - first, 5 * MIN);
  const expected = Math.round(span / (5 * MIN)) + 1;
  const got = pts.length - restarts;
  const rs = pts.map(p => p.rssi).filter(x => x !== null && !isNaN(x));
  return {gaps, longestGapMin: longest / MIN, restarts, coverage: Math.min(1, got / expected), lastSeenMin: (nowT - last) / MIN,
          rssi: rs.length ? rs.reduce((a, b) => a + b, 0) / rs.length : null};
}

/* average temp and out-of-range share per hour of day */
function hourly(pts, lo, hi){
  const h = Array.from({length: 24}, () => ({n: 0, sum: 0, out: 0}));
  pts.forEach(p => { const k = new Date(p.t).getUTCHours(); h[k].n++; h[k].sum += p.v; if (stateOf(p.v, lo, hi) !== 'in') h[k].out++; });
  return h.map(x => x.n ? {avg: x.sum / x.n, out: x.out / x.n, n: x.n} : null);
}

/* project the next cycle events (peaks and troughs) from the latest confirmed extreme */
function projectCycle(C, nowT, horizonMs){
  if (!C || !C.lastExt || C.peakV === null || C.troughV === null) return [];
  const out = []; let k = C.lastExt.k, t = C.lastExt.t, guard = 0;
  if (nowT - t > 3 * C.periodMin * MIN) return [];
  while (t < nowT + horizonMs && guard++ < 40){
    if (k === 'hi'){ t += C.coolMin * MIN; k = 'lo'; } else { t += C.warmMin * MIN; k = 'hi'; }
    if (t > nowT) out.push({k, t, v: k === 'hi' ? C.peakV : C.troughV});
  }
  return out;
}

/* 0 to 100 cooling health: time in range, swing, compressor load, logger coverage */
function healthScore(S, C, Hh, online){
  let s = 100 - 45 * (1 - S.inRange);
  if (C){ s -= 15 * Math.min(1, Math.max(0, (C.swing - 3) / 6)); s -= 15 * Math.max(0, (C.duty - .6) / .4); }
  s -= 15 * (1 - Hh.coverage);
  if (!online) s -= 20;
  return Math.max(0, Math.min(100, Math.round(s)));
}

