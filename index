  const cond = {chill: ['snow', 'Cold and steady'], warm: [last.v < P.lo ? 'snow' : 'sun', last.v < P.lo ? 'Running cold' : 'Running warm'], storm: ['bolt', 'Out of range'], fog: ['cloudoff', 'Logger offline']}[scene];
  $('cond').innerHTML = icon(cond[0]) + '<span>' + cond[1] + '</span>';
  $('cond2').textContent = scene === 'fog' ? 'No reading for ' + dur(lastSeenMin) + '. Last was ' + f1(last.v) + '°.' : 'L ' + f1(vmin) + '°  ·  H ' + f1(vmax) + '°  ·  Cooling health ' + score + ' ' + (score >= 85 ? 'Excellent' : score >= 70 ? 'Good' : score >= 50 ? 'Moderate' : score >= 30 ? 'Poor' : 'Critical');
  const nextPeak = proj.find(e => e.k === 'hi');
  $('nextChip').innerHTML = nextPeak ? '<span class="pill">' + icon('sun') + 'Next warm peak about ' + hhmm(nextPeak.t) + ' · ' + f1(nextPeak.v) + '°</span>' : '';

  // carousel
