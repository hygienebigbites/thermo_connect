    cur.push(p);
  });
  if (cur.length) runs.push(cur);
  const dPath = runs.map(r => r.map((p, i) => (i ? 'L' : 'M') + X(p.t).toFixed(1) + ' ' + Y(p.v).toFixed(1)).join(' ')).join(' ');
  const la = {fill: 'none', 'stroke-width': 2.2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round'};
  el('path', Object.assign({d: dPath, stroke: 'var(--in)'}, la), svg);
  el('path', Object.assign({d: dPath, stroke: 'var(--out)', 'clip-path': 'url(#clipHi)'}, la), svg);
  el('path', Object.assign({d: dPath, stroke: 'var(--out)', 'clip-path': 'url(#clipLo)'}, la), svg);
  const lp = d.valid[d.valid.length - 1];
  if (proj.length){
    let pd = 'M' + X(lp.t).toFixed(1) + ' ' + Y(lp.v).toFixed(1);
    proj.forEach(e => { pd += ' L' + X(e.t).toFixed(1) + ' ' + Y(e.v).toFixed(1); });
    el('path', {d: pd, fill: 'none', stroke: '#fff', 'stroke-width': 2, 'stroke-dasharray': '2 6', 'stroke-linecap': 'round', opacity: .85}, svg);
  }
  el('circle', {cx: X(lp.t), cy: Y(lp.v), r: 5, fill: lp.v > P.hi || lp.v < P.lo ? 'var(--out)' : 'var(--in)', stroke: '#fff', 'stroke-width': 2}, svg);

  const cross = el('line', {y1: m.t, y2: H - m.b, stroke: 'rgba(255,255,255,.6)', visibility: 'hidden'}, svg);
