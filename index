  if (C){ const dayCost = C.duty * watts / 1000 * 24 * tariff;
    slides.push('<div class="slide"><p class="t">' + icon('rupee') + '₹' + Math.round(dayCost) + ' a day to run</p><p>About ₹' + Math.round(dayCost * 30).toLocaleString('en-IN') + ' a month at ' + watts + ' W and ₹' + tariff + ' per kWh. This is an estimate.</p><a data-jump="cardCost">View details ›</a></div>'); }
