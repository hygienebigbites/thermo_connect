  return list;
}

/* compressor cycles via zigzag with a minimum swing threshold */
function cycleStats(pts, thr){
  thr = thr || 1.5;
  const segs = []; let seg = [];
  pts.forEach((p, i) => { if (i && p.t - pts[i-1].t > GAP_MS){ segs.push(seg); seg = []; } seg.push(p); });
  if (seg.length) segs.push(seg);
