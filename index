/* ===== pure logic: parsing + analysis (no DOM) ===== */
const MIN = 60000;
const GAP_MS = 15 * MIN;          // a gap longer than this breaks lines and cycles
const WCAP = 6 * MIN;             // a reading covers at most 6 minutes of time

function parseCSV(text){
  const rows = []; let row = [], cur = '', q = false;
  for (let i = 0; i < text.length; i++){
    const c = text[i];
    if (q){ if (c === '"'){ if (text[i+1] === '"'){ cur += '"'; i++; } else q = false; } else cur += c; }
    else if (c === '"') q = true;
    else if (c === ','){ row.push(cur); cur = ''; }
    else if (c === '\n'){ row.push(cur); rows.push(row); row = []; cur = ''; }
    else if (c !== '\r') cur += c;
  }
  if (cur.length || row.length){ row.push(cur); rows.push(row); }
  return rows;
}
function parseTime(s){
  s = String(s || '').trim();
  let m = s.match(/^(\d{4})-(\d{2})-(\d{2})[ T](\d{1,2}):(\d{2})(?::(\d{2}))?/);
  if (m) return Date.UTC(+m[1], +m[2]-1, +m[3], +m[4], +m[5], +(m[6] || 0));
  m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})[ ,]+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?/i);
  if (m){
    let a = +m[1], b = +m[2], h = +m[4];
    let d = a, mo = b; if (b > 12 && a <= 12){ d = b; mo = a; }   // India: day first, unless clearly month first
    if (m[7]){ const pm = m[7].toUpperCase() === 'PM'; if (pm && h < 12) h += 12; if (!pm && h === 12) h = 0; }
    return Date.UTC(+m[3], mo-1, d, h, +m[5], +(m[6] || 0));
  }
  return NaN;
}
function rowsFromCSV(text){
  const table = parseCSV(text); if (!table.length) return [];
  const head = table[0].map(h => h.trim().toLowerCase());
  const ix = n => head.findIndex(h => h.includes(n));
  const iT = ix('time'), iD = ix('device'), iV = ix('temp'), iR = ix('wifi');
  if (iT < 0 || iV < 0) return [];
  const out = [];
  for (let i = 1; i < table.length; i++){
    const r = table[i]; const t = parseTime(r[iT]); if (isNaN(t)) continue;
    const vs = (r[iV] || '').trim(); const v = vs === '' || isNaN(parseFloat(vs)) ? null : parseFloat(vs);
    out.push({t, dev: iD >= 0 && (r[iD] || '').trim() ? r[iD].trim() : 'Device', v, rssi: iR >= 0 && r[iR] !== '' ? parseInt(r[iR], 10) : null});
  }
  out.sort((a, b) => a.t - b.t);
  return out;
}

function weights(pts){
  return pts.map((p, i) => {
    const dt = i < pts.length - 1 ? pts[i+1].t - p.t : 5 * MIN;
    return Math.min(dt, WCAP);
  });
}
function stateOf(v, lo, hi){ return v > hi ? 'above' : v < lo ? 'below' : 'in'; }

/* time-weighted share in / above / below range, plus time-weighted mean */
function share(pts, lo, hi){
  const w = weights(pts); let tot = 0, inr = 0, ab = 0, be = 0, sum = 0;
  pts.forEach((p, i) => { tot += w[i]; sum += p.v * w[i]; const s = stateOf(p.v, lo, hi); if (s === 'above') ab += w[i]; else if (s === 'below') be += w[i]; else inr += w[i]; });
  return {inRange: inr / tot, above: ab / tot, below: be / tot, minutes: tot / MIN, aboveMin: ab / MIN, belowMin: be / MIN, mean: sum / tot};
}

/* excursions = runs of readings outside the range */
function excursions(pts, lo, hi){
  const list = []; let cur = null;
  const close = (endT) => { if (cur){ cur.end = endT; cur.dur = (cur.end - cur.start) / MIN; list.push(cur); cur = null; } };
  for (let i = 0; i < pts.length; i++){
    const p = pts[i], out = stateOf(p.v, lo, hi) !== 'in';
    if (i > 0 && p.t - pts[i-1].t > GAP_MS) close(pts[i-1].t + 5 * MIN);
