    cross.setAttribute('x1', X(best.t)); cross.setAttribute('x2', X(best.t)); cross.setAttribute('visibility', 'visible');
    dot.setAttribute('cx', X(best.t)); dot.setAttribute('cy', Y(best.v)); dot.setAttribute('visibility', 'visible');
