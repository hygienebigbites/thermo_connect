    tip.innerHTML = '<div class="t">' + dmy(best.t) + ' ' + hhmm(best.t) + ' IST</div><b>' + best.v.toFixed(2) + ' °C</b><div>' + stateText(best.v, P.lo, P.hi) + '</div>' + (best.rssi !== null ? '<div class="t">Wi-Fi ' + best.rssi + ' dBm</div>' : '');
    placeTip(host, tip, X(best.t) / sx, Y(best.v) / sx);
  }
  const leave = () => { tip.hidden = true; cross.setAttribute('visibility', 'hidden'); dot.setAttribute('visibility', 'hidden'); };
  hit.addEventListener('pointermove', move); hit.addEventListener('pointerdown', move); hit.addEventListener('pointerleave', leave);

  $('rangeLabel').textContent = dmy(t0) + ' ' + hhmm(t0) + ' to ' + dmy(Math.min(t1, Math.max(nowRef, pts[pts.length - 1].t))) + ' ' + hhmm(Math.min(t1, Math.max(nowRef, pts[pts.length - 1].t)));
  $('legend1').innerHTML =
    '<li><span class="sw" style="background:var(--in)"></span>Inside range</li>' +
    '<li><span class="sw" style="background:var(--out)"></span>Outside range</li>' +
    '<li><span class="sw box" style="background:rgba(255,255,255,.12);border:1px dashed rgba(255,255,255,.5)"></span>Safe range ' + P.lo + ' to ' + P.hi + ' °C</li>' +
    '<li><span class="sw box" style="background:repeating-linear-gradient(45deg,rgba(255,255,255,.2) 0 2px,transparent 2px 5px)"></span>No data</li>' +
    (proj.length ? '<li><span class="sw" style="background:repeating-linear-gradient(90deg,#fff 0 2px,transparent 2px 7px)"></span>Next 2 h, projected</li>' : '');
}

/* ---------------- hourly + daily ---------------- */
function renderHourly(P, validAll){
  const lastH = Math.floor(nowRef / 3600000) * 3600000;
  const bins = [];
  for (let i = 7; i >= 0; i--){
    const h0 = lastH - i * 3600000, h1 = h0 + 3600000;
    const pts = validAll.filter(p => p.t >= h0 && p.t < h1);
    if (!pts.length){ bins.push({h0, none: true}); continue; }
    const avg = pts.reduce((a, p) => a + p.v, 0) / pts.length;
    const out = pts.filter(p => stateOf(p.v, P.lo, P.hi) !== 'in').length / pts.length;
    bins.push({h0, avg, out});
  }
  $('hourly').innerHTML = bins.map((b, i) => '<div class="hr"><div class="l">' + (i === 7 ? 'Now' : pad(new Date(b.h0).getUTCHours()) + ':00') + '</div>' +
    icon(b.none ? 'cloudoff' : iconFor(b.out)) +
    '<div class="v">' + (b.none ? '–' : f1(b.avg) + '°') + '</div><div class="p">' + (b.none ? 'no data' : pct(b.out) + ' out') + '</div></div>').join('');
  $('hourlyHint').textContent = 'Average per clock hour';
  $('hourlyKey').innerHTML = '<span>' + icon('snow') + 'Steady</span><span>' + icon('sun') + 'Some warm spells</span><span>' + icon('bolt') + 'Mostly out of range</span><span>' + icon('cloudoff') + 'No data</span>';
}
function dayBuckets(P, validAll){
  const map = new Map();
  validAll.forEach(p => { const k = Math.floor(p.t / 86400000); if (!map.has(k)) map.set(k, []); map.get(k).push(p); });
  const today = Math.floor(nowRef / 86400000);
  return Array.from(map.entries()).sort((a, b) => a[0] - b[0]).slice(-7).map(([k, pts]) => {
    const vs = pts.map(p => p.v), t = k * 86400000;
    const out = pts.filter(p => stateOf(p.v, P.lo, P.hi) !== 'in').length / pts.length;
    return {k, label: k === today ? 'Today' : k === today - 1 ? 'Yesterday' : DOW[new Date(t).getUTCDay()], date: dmy(t), hi: Math.max(...vs), lo: Math.min(...vs), out, n: pts.length};
  });
}
function renderDaily(P, validAll){
  const D = dayBuckets(P, validAll), host = $('daily');
  document.getElementById('dv-line').setAttribute('aria-pressed', String(state.dview === 'line'));
  document.getElementById('dv-list').setAttribute('aria-pressed', String(state.dview === 'list'));
  if (!D.length){ host.innerHTML = '<p class="hint">No days with readings yet.</p>'; return; }
  const gmin = Math.min(...D.map(x => x.lo), P.lo), gmax = Math.max(...D.map(x => x.hi), P.hi);
  if (state.dview === 'list'){
    host.innerHTML = '<div class="dlist">' + D.map(x => {
      const L = v => ((v - gmin) / (gmax - gmin) * 100).toFixed(1);
      return '<div class="drow"><div class="d">' + x.label + '<small>' + x.date + '</small></div>' + icon(iconFor(x.out)) +
        '<div class="n">' + f1(x.lo) + '°</div><div class="rng"><div class="band" style="left:' + L(P.lo) + '%;width:' + (L(P.hi) - L(P.lo)).toFixed(1) + '%"></div><div class="bar2" style="left:' + L(x.lo) + '%;width:' + Math.max(1.5, L(x.hi) - L(x.lo)).toFixed(1) + '%"></div></div>' +
        '<div class="n">' + f1(x.hi) + '°</div></div>';
    }).join('') + '</div><p class="hint" style="margin-top:8px">Shaded strip is your safe range. Bar shows the lowest to highest reading of the day.</p>';
    return;
  }
  const W = Math.max(300, host.clientWidth), colW = W / D.length, H = 296;
  const yTop = 140, yBot = 232, span = Math.max(1, gmax - gmin);
  const Y = v => yBot - (v - gmin) / span * (yBot - yTop);
  host.innerHTML = '';
  const svg = el('svg', {viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': 'Daily highest and lowest temperature'}, host);
  const cx = i => colW * i + colW / 2;
  const smooth = pts => pts.length < 2 ? '' : pts.map((p, i) => { if (!i) return 'M' + p[0] + ' ' + p[1]; const q = pts[i-1], mx = (q[0] + p[0]) / 2; return 'C' + mx + ' ' + q[1] + ' ' + mx + ' ' + p[1] + ' ' + p[0] + ' ' + p[1]; }).join(' ');
  el('rect', {x: 0, y: Y(P.hi), width: W, height: Math.max(2, Y(P.lo) - Y(P.hi)), fill: 'rgba(255,255,255,.09)', rx: 6}, svg);
  el('path', {d: smooth(D.map((x, i) => [cx(i), Y(x.hi)])), stroke: '#fff', 'stroke-opacity': .7, 'stroke-width': 2, fill: 'none'}, svg);
  el('path', {d: smooth(D.map((x, i) => [cx(i), Y(x.lo)])), stroke: '#fff', 'stroke-opacity': .7, 'stroke-width': 2, fill: 'none'}, svg);
  D.forEach((x, i) => {
    el('text', {x: cx(i), y: 18, 'text-anchor': 'middle', 'font-size': 15, 'font-weight': 700}, svg).textContent = x.label;
    el('text', {x: cx(i), y: 36, 'text-anchor': 'middle', 'font-size': 12, 'fill-opacity': .7}, svg).textContent = x.date;
    const u = el('use', {href: '#i-' + iconFor(x.out), x: cx(i) - 16, y: 48, width: 32, height: 32, color: '#fff'}, svg);
    el('text', {x: cx(i), y: 98, 'text-anchor': 'middle', 'font-size': 12, 'font-weight': 600, fill: 'var(--in)'}, svg).textContent = pct(x.out) + ' out';
    el('text', {x: cx(i), y: Y(x.hi) - 11, 'text-anchor': 'middle', 'font-size': 17, 'font-weight': 500}, svg).textContent = f1(x.hi) + '°';
    el('circle', {cx: cx(i), cy: Y(x.hi), r: 4.5, fill: '#fff'}, svg);
    el('circle', {cx: cx(i), cy: Y(x.lo), r: 4.5, fill: '#fff'}, svg);
    el('text', {x: cx(i), y: Y(x.lo) + 24, 'text-anchor': 'middle', 'font-size': 17, 'font-weight': 500}, svg).textContent = f1(x.lo) + '°';
  });
}

/* ---------------- main render ---------------- */
function renderAll(){
  const devs = devices();
  if (!devs.length) return;
  if (!devs.includes(state.dev)) state.dev = devs[0];
  const devSel = $('dev');
  if (devSel.options.length !== devs.length || Array.from(devSel.options).some((o, i) => o.value !== devs[i])) devSel.innerHTML = devs.map(x => '<option>' + x + '</option>').join('');
  devSel.value = state.dev; $('unitName').textContent = state.dev;
  const P = profileFor(state.dev);
  $('profile').value = P.key; $('loBox').hidden = $('hiBox').hidden = P.key !== 'custom'; $('lo').value = P.lo; $('hi').value = P.hi;
  document.querySelectorAll('.seg button[data-w]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.w === state.win)));
  const d = windowed(state.dev);
  const everyone = ALL.filter(r => r.dev === state.dev);
  const lastAny = everyone[everyone.length - 1];
  const lastSeenMin = (nowRef - lastAny.t) / MIN;
  const online = lastSeenMin <= CONFIG.STALE_MINUTES;

  // banner
  const b = $('banner');
  if (LOAD_ERR){ b.hidden = false; b.className = 'banner bad'; b.textContent = 'Could not load the sheet (' + LOAD_ERR + '). Showing ' + (MODE === 'live' ? 'the last data loaded.' : 'demo data.'); }
  else if (MODE === 'demo'){ b.hidden = false; b.className = 'banner'; b.textContent = 'Showing a snapshot from a real 700 L visi cooler test (17 to 18 Oct 2026). Open Settings and paste your published CSV link to see your own live data.'; }
  else b.hidden = true;

  // status pills
  const st = [];
  st.push(MODE === 'live' ? '<span class="pill ' + (online ? 'good' : 'bad') + '">' + (online ? '● Online' : '▲ Offline') + '</span>' : '<span class="pill warn">▲ Demo data</span>');
  st.push('<span class="pill">' + icon('thermo') + PROFILES[P.key].name + ' · ' + P.lo + ' to ' + P.hi + ' °C</span>');
  st.push('<span class="pill">' + icon('clock') + (lastSeenMin < 1 ? 'just now' : dur(lastSeenMin) + ' ago') + '</span>');
  if (MODE === 'live') st.push('<span class="pill" id="countdown">Refresh in ' + CONFIG.REFRESH_SECONDS + ' s</span>');
  $('status').innerHTML = st.join('');

  if (!d.valid.length){
    $('temp').innerHTML = '<span class="i">--</span>';
    $('cond').textContent = 'No readings in this window'; $('cond2').textContent = 'Choose a longer window or check the logger.';
    ['car', 'dots', 'hourly', 'hourlyKey', 'daily', 'cardIndex', 'tiles', 'actions', 'cardFood', 'cardEquip', 'cardCost', 'cardHealth', 'hours', 'dayBar', 'tips', 'nextChip'].forEach(i => $(i).innerHTML = '');
    drawChart(P, d, null, false); setScene(FORCE || 'fog'); return;
  }
  const S = share(d.valid, P.lo, P.hi);
  const E = excursions(d.valid, P.lo, P.hi);
  const longest = E.reduce((a, e) => Math.max(a, e.dur), 0);
  const C = cycleStats(d.valid, 1.5);
  const Hh = health(d.inWin, nowRef);
  const last = d.valid[d.valid.length - 1];
  const vals = d.valid.map(p => p.v), vmax = Math.max(...vals), vmin = Math.min(...vals);
  const spanMin = (last.t - d.valid[0].t) / MIN;
  const watts = parseFloat(store.get('watts', '350')) || 0, tariff = parseFloat(store.get('tariff', '8')) || 0;
  const ongoing = E.length && E[E.length - 1].ongoing ? E[E.length - 1] : null;
  const score = healthScore(S, C, Hh, online || MODE === 'demo');
  const proj = (online || MODE === 'demo') ? projectCycle(C, nowRef, 2 * 3600000) : [];

  // scene
  const pick = FORCE || store.get('scene', 'auto');
  let scene = 'chill';
  if (MODE === 'live' && !online) scene = 'fog';
  else if (S.inRange < .5 || (ongoing && ongoing.dur >= 30)) scene = 'storm';
  else if (S.inRange < .92 || last.v > P.hi || last.v < P.lo) scene = 'warm';
  if (pick !== 'auto' && ['chill', 'warm', 'storm', 'fog'].includes(pick)) scene = pick;
