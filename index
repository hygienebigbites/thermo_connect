      if (dir <= 0 && p.v - loP.v >= thr){ ext.push({k: 'lo', t: loP.t, v: loP.v}); dir = 1; hiP = p; }
      else if (dir >= 0 && hiP.v - p.v >= thr){ ext.push({k: 'hi', t: hiP.t, v: hiP.v}); dir = -1; loP = p; }
    }
    const e = ext.slice(1);                       // first extreme is partial
