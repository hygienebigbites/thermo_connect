    '<p class="note" style="margin-top:6px">' + (score >= 70 ? 'The unit is holding its range and the logger is reliable.' : 'Pulled down by ' + [S.inRange < .9 ? 'time out of range' : '', C && C.swing > 5 ? 'wide swings' : '', C && C.duty > .7 ? 'compressor load' : '', Hh.coverage < .9 ? 'missing readings' : '', !online && MODE === 'live' ? 'the logger being offline' : ''].filter(Boolean).join(', ') + '.') + '</p>' +
    '<div class="scale"><i style="left:' + score + '%"></i></div><div class="hint" style="display:flex;justify-content:space-between"><span>Critical</span><span>Excellent</span></div>';

  // tiles
  const T = [
    ['gauge', 'Compressor on', C ? pct(C.duty) : '–', C && C.duty > .7],
    ['clock', 'Cycle', C ? Math.round(C.periodMin) + '<small> min</small>' : '–', C && C.periodMin < 20],
    ['thermo', 'Swing', C ? f1(C.swing) + '<small> °C</small>' : '–', C && C.swing > 5],
    ['wifi', 'Wi-Fi', Hh.rssi === null ? '–' : Math.round(Hh.rssi) + '<small> dBm</small>', Hh.rssi !== null && Hh.rssi < -80],
    ['shield', 'Readings in', pct(Hh.coverage), Hh.coverage < .9],
    ['rupee', 'Cost per day', C ? '₹' + Math.round(C.duty * watts / 1000 * 24 * tariff) : '–', false]
  ];
  $('tiles').innerHTML = T.map(t => '<div class="tile' + (t[3] ? ' flag' : '') + '">' + icon(t[0]) + '<div class="k">' + t[1] + '</div><div class="v">' + t[2] + '</div></div>').join('');

  // actions
  const A = [];
  if (!online && MODE === 'live') A.push(['bad', 'Act now', 'The logger has sent nothing for <b>' + dur(lastSeenMin) + '</b>. Check the USB charger, the cable and the Wi-Fi at the unit. Until it is back, check the unit by hand.']);
  if (ongoing && ongoing.dur >= 30) A.push(['bad', 'Act now', 'The unit has been out of range for <b>' + dur(ongoing.dur) + '</b> and is at ' + f1(last.v) + ' °C. Check the door seal and the power, and move high-risk food to a unit that is holding.']);
  if (S.inRange < .8) A.push([S.inRange < .5 ? 'bad' : 'warn', S.inRange < .5 ? 'Act now' : 'Check soon', 'Only <b>' + pct(S.inRange) + '</b> of the time is inside ' + P.lo + ' to ' + P.hi + ' °C. Turn the thermostat down one notch, check the door gasket and clean the condenser coil, then compare the next 24 hours.']);
  if (C && C.swing > 5) A.push(['warn', 'Check soon', 'Temperature swings <b>' + f1(C.swing) + ' °C</b> each cycle. Move the probe into a sealed bottle of water on the middle shelf so you read product temperature, not air.']);
