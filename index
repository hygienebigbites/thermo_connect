function drawChart(P, d, C, online){
  const host = $('chart1'); host.innerHTML = '';
  if (!d.valid.length){ host.innerHTML = '<p class="hint">No readings in this window. Try a longer window.</p>'; $('legend1').innerHTML = ''; $('rangeLabel').textContent = ''; return; }
  const W = Math.max(300, host.clientWidth), H = W < 520 ? 280 : 320;
  const m = {l: 38, r: 12, t: 12, b: 30};
  const pts = d.inWin;
  const proj = online ? projectCycle(C, nowRef, 2 * 3600000) : [];
  const t0 = isFinite(d.cutoff) ? Math.max(d.cutoff, pts[0].t) : pts[0].t;
  const tEnd = Math.max(pts[pts.length - 1].t, nowRef) + (proj.length ? 2 * 3600000 : 0);
  const t1 = tEnd > t0 ? tEnd : t0 + 5 * MIN;
  const vv = d.valid.map(p => p.v).concat(proj.map(p => p.v));
  const ymin = Math.floor(Math.min(...vv, P.lo) - 1), ymax = Math.ceil(Math.max(...vv, P.hi) + 1);
  const pw = W - m.l - m.r, ph = H - m.t - m.b;
  const X = t => m.l + (t - t0) / (t1 - t0) * pw;
  const Y = v => m.t + (1 - (v - ymin) / (ymax - ymin)) * ph;
  const svg = el('svg', {viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': 'Line chart of temperature over time against the safe range'}, host);
  const defs = el('defs', {}, svg);
  const pat = el('pattern', {id: 'hatch', width: 7, height: 7, patternUnits: 'userSpaceOnUse', patternTransform: 'rotate(45)'}, defs);
  el('line', {x1: 0, y1: 0, x2: 0, y2: 7, stroke: 'rgba(255,255,255,.16)', 'stroke-width': 3}, pat);
  el('rect', {x: m.l, y: 0, width: pw, height: Math.max(0, Y(P.hi))}, el('clipPath', {id: 'clipHi'}, defs));
  el('rect', {x: m.l, y: Y(P.lo), width: pw, height: Math.max(0, H - Y(P.lo))}, el('clipPath', {id: 'clipLo'}, defs));
  const ystep = (ymax - ymin) > 30 ? 10 : (ymax - ymin) > 16 ? 5 : 2;
  for (let v = Math.ceil(ymin / ystep) * ystep; v <= ymax; v += ystep){
    el('line', {x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: 'rgba(255,255,255,.13)'}, svg);
    el('text', {x: m.l - 8, y: Y(v) + 4, 'text-anchor': 'end'}, svg).textContent = v;
  }
  const hours = (t1 - t0) / 3600000, pxh = pw / hours;
  const nd = new Date(t0);
  if (hours > 36){
    const dayStep = pxh * 24 >= 70 ? 1 : 2;
    let tk = Date.UTC(nd.getUTCFullYear(), nd.getUTCMonth(), nd.getUTCDate() + 1);
    for (let i = 0; tk <= t1; tk += 86400000, i++){ if (i % dayStep) continue;
      el('line', {x1: X(tk), x2: X(tk), y1: H - m.b, y2: H - m.b + 4, stroke: 'rgba(255,255,255,.5)'}, svg);
      el('text', {x: X(tk), y: H - m.b + 17, 'text-anchor': 'middle'}, svg).textContent = dmy(tk); }
  } else {
    const step = pxh >= 56 ? 1 : pxh >= 28 ? 2 : pxh >= 14 ? 3 : 6;
    let tk = Date.UTC(nd.getUTCFullYear(), nd.getUTCMonth(), nd.getUTCDate(), nd.getUTCHours() + 1);
    while (new Date(tk).getUTCHours() % step !== 0) tk += 3600000;
    for (; tk <= t1; tk += step * 3600000){
      el('line', {x1: X(tk), x2: X(tk), y1: H - m.b, y2: H - m.b + 4, stroke: 'rgba(255,255,255,.5)'}, svg);
      el('text', {x: X(tk), y: H - m.b + 17, 'text-anchor': 'middle'}, svg).textContent = hhmm(tk); }
  }
  el('rect', {x: m.l, y: Y(P.hi), width: pw, height: Y(P.lo) - Y(P.hi), fill: 'rgba(255,255,255,.10)', rx: 4}, svg);
  [P.hi, P.lo].forEach(v => el('line', {x1: m.l, x2: W - m.r, y1: Y(v), y2: Y(v), stroke: 'rgba(255,255,255,.5)', 'stroke-dasharray': '4 4'}, svg));

  const gapList = [];
  for (let i = 1; i < pts.length; i++) if (pts[i].t - pts[i-1].t > GAP_MS) gapList.push([pts[i-1].t, pts[i].t]);
  if (nowRef - pts[pts.length - 1].t > GAP_MS) gapList.push([pts[pts.length - 1].t, nowRef]);
