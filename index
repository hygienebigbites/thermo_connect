  $('actions').innerHTML = A.map(a => '<li>' + chip(a[0], a[1]) + '<p>' + a[2] + '</p></li>').join('');

  // service hours
  const nd = new Date(nowRef), nowH = nd.getUTCHours() + nd.getUTCMinutes() / 60;
  const X0 = 6, X1 = 24, pos = h => ((Math.min(Math.max(h, X0), X1) - X0) / (X1 - X0) * 100).toFixed(1) + '%';
  $('dayBar').innerHTML = '<div class="track"></div>' + CONFIG.RUSH.map((r, i) => '<div class="rush" style="left:' + pos(r[0]) + ';width:' + ((r[1] - r[0]) / (X1 - X0) * 100).toFixed(1) + '%"></div><div class="lab" style="left:' + pos((r[0] + r[1]) / 2) + '">' + (i === 0 ? 'Lunch' : 'Dinner') + '</div>').join('') +
    '<div class="now" style="left:' + pos(nowH) + '"></div>' + [6, 12, 18, 24].map(h => '<div class="tick" style="left:' + pos(h) + '">' + pad(h % 24) + 'h</div>').join('');
  const H24 = hourly(d.valid, P.lo, P.hi);
  $('hours').innerHTML = H24.map((h, i) => h
    ? '<div class="hour" style="background:rgba(255,171,94,' + (0.06 + h.out * 0.5).toFixed(2) + ')" title="' + pad(i) + ':00 · avg ' + f1(h.avg) + ' °C · ' + pct(h.out) + ' of readings out of range"><div class="h">' + pad(i) + 'h</div><div class="a">' + f1(h.avg) + '</div></div>'
    : '<div class="hour empty"><div class="h">' + pad(i) + 'h</div><div class="a">–</div></div>').join('');
  const filled = H24.map((h, i) => h ? Object.assign({h: i}, h) : null).filter(Boolean), days = spanMin / 1440;
  $('hourHint').textContent = 'Average °C by hour · warmer tint means more time out of range';
  if (filled.length && days >= 2){
    const worst = filled.reduce((a, c) => c.out > a.out ? c : a);
    const rush = filled.filter(x => CONFIG.RUSH.some(r => x.h >= r[0] && x.h < r[1]));
    const rushOut = rush.length ? rush.reduce((a, x) => a + x.out, 0) / rush.length : null;
    $('hourNote').innerHTML = 'Worst hour is <b>' + pad(worst.h) + ':00</b> with ' + pct(worst.out) + ' of readings out of range.' + (rushOut !== null ? ' During lunch and dinner rush it is ' + pct(rushOut) + '. Door openings in service hours push temperatures up, so restock in batches and keep the door shut between pulls.' : '');
  } else $('hourNote').textContent = 'This view needs about 2 days of data to show whether lunch and dinner rush push the unit out of range. So far there is ' + (days < 1 ? 'under a day' : f1(days) + ' days') + ' of readings.';

  // tips (highlight the ones that match the readings)
  const TIPS = [
    ['door', 'Keep the door shut between pulls', S.inRange < .8],
    ['bottle', 'Put the probe in a bottle of water', !!(C && C.swing > 5)],
    ['wind', 'Clean the condenser coil', !!((C && C.duty > .6) || S.inRange < .8)],
    ['shield', 'Check the door gasket', S.inRange < .8],
    ['plug', 'Use a steady 5 V charger', Hh.restarts > 2],
    ['thermo', P.key === 'visi' ? 'Keep dairy in a chiller, not here' : 'Restock in small batches', P.key === 'visi'],
    ['gauge', 'Do not block the air vents', !!(C && C.duty > .7)],
    ['wrench', 'Service the unit every 6 months', false],
    ['clock', 'Log a manual check once a shift', !online && MODE === 'live']
  ];
  $('tips').innerHTML = TIPS.map(t => '<div class="tip2' + (t[2] ? ' hot' : '') + '">' + icon(t[0]) + t[1] + '</div>').join('');

  // details
  $('cardFood').innerHTML = '<div class="card-h"><h2>Food safety</h2>' + chip(S.inRange >= .95 ? 'good' : S.inRange >= .8 ? 'warn' : 'bad', S.inRange >= .95 ? 'On track' : S.inRange >= .8 ? 'Watch' : 'At risk') + '</div>' +
    '<div class="big">' + dur(S.aboveMin + S.belowMin) + '<small> out of range</small></div>' +
    '<ul class="rows">' + row('Time above ' + P.hi + ' °C', dur(S.aboveMin)) + row('Time below ' + P.lo + ' °C', dur(S.belowMin)) + row('Excursions', E.length) + row('Longest excursion', E.length ? dur(longest) : '–') + row('Hottest reading', f1(vmax) + ' °C') + '</ul>' +
    (dz ? '<p class="note">A widely used rule: high-risk food held above 5 °C for more than 2 hours in total is discarded. This window shows <b>' + dur(S.aboveMin) + '</b> above 5 °C' + (S.aboveMin > 120 ? ', which is over that allowance. Check with your food-safety officer before serving stock from this unit.' : ', which is within that allowance.') + '</p>'
      : '<p class="note">' + (P.key === 'visi' ? 'A visi cooler suits drinks and packaged items. Keep dairy, cut fruit and prepared food in a chiller held at 5 °C or below.' : P.key === 'freezer' ? 'Frozen stock should stay at −18 °C or colder. Any rise above it means partial thawing.' : 'Judged against your custom range.') + '</p>');
  if (C){
    const bad = []; if (C.periodMin < 20) bad.push('short cycles'); if (C.swing > 5) bad.push('wide swing'); if (C.duty > .7) bad.push('compressor working hard');
    $('cardEquip').innerHTML = '<div class="card-h"><h2>Cooling unit health</h2>' + chip(bad.length === 0 ? 'good' : bad.length === 1 ? 'warn' : 'bad', bad.length ? bad.join(', ') : 'Healthy cycle') + '</div>' +
      '<div class="big">' + Math.round(C.periodMin) + '<small> min per cycle</small></div>' +
      '<ul class="rows">' + row('Temperature swing', f1(C.swing) + ' °C') + row('Cooling phase', Math.round(C.coolMin) + ' min') + row('Warming phase', Math.round(C.warmMin) + ' min') + row('Compressor on', pct(C.duty) + ' of the time') + row('Cycles measured', C.cycles) + '</ul>' +
      '<p class="note">' + (C.swing > 5 ? 'A swing this wide usually means the probe is in open air near the glass door, or the thermostat differential is set wide. Put the probe in a sealed bottle of water to read stock temperature instead of air. ' : '') + (C.duty > .7 ? 'The compressor is running most of the time. Check the condenser coil, ventilation behind the unit and overloading. ' : '') + (!bad.length ? 'Cycle length, swing and run time are all in a normal band.' : '') + '</p>';
    const kwhDay = C.duty * watts / 1000 * 24, costDay = kwhDay * tariff;
    $('cardCost').innerHTML = '<div class="card-h"><h2>Running cost estimate</h2><span class="chip warn">Estimate</span></div>' +
      '<div class="big">₹' + Math.round(costDay) + '<small> per day</small></div>' +
      '<ul class="rows">' + row('Energy per day', f1(kwhDay) + ' kWh') + row('Cost per month', '₹' + Math.round(costDay * 30).toLocaleString('en-IN')) + row('Compressor power used', watts + ' W') + row('Tariff used', '₹' + tariff + ' per kWh') + '</ul>' +
      '<p class="note">Uses the share of time the temperature is falling as the compressor run time. Enter the power from the nameplate and your tariff in Settings for a closer figure. A unit that cycles harder costs more every day.</p>';
  } else {
    $('cardEquip').innerHTML = '<div class="card-h"><h2>Cooling unit health</h2></div><p class="note">Not enough clean cooling cycles in this window yet. Try a longer window or wait a few hours of data.</p>';
    $('cardCost').innerHTML = '<div class="card-h"><h2>Running cost estimate</h2></div><p class="note">Needs a few clean cooling cycles to estimate compressor run time.</p>';
  }
  const hk = !online && MODE === 'live' ? 'bad' : Hh.coverage >= .95 && !Hh.restarts && !Hh.gaps ? 'good' : 'warn';
  $('cardHealth').innerHTML = '<div class="card-h"><h2>Logger health</h2>' + chip(hk, hk === 'good' ? 'Reliable' : hk === 'bad' ? 'Offline' : 'Needs attention') + '</div>' +
    '<div class="big">' + pct(Hh.coverage) + '<small> of readings received</small></div>' +
    '<ul class="rows">' + row('Last reading', lastSeenMin < 1 ? 'just now' : dur(lastSeenMin) + ' ago') + row('Gaps over 15 min', Hh.gaps + (Hh.gaps ? ' (longest ' + dur(Hh.longestGapMin) + ')' : '')) + row('Restarts seen', Hh.restarts) + row('Sensor errors', d.errors) + row('Wi-Fi signal', Hh.rssi === null ? '–' : Math.round(Hh.rssi) + ' dBm') + '</ul>' +
    '<p class="note">' + (Hh.restarts ? 'Restarts show as readings less than a minute apart. Check the charger and the USB cable. ' : '') + (Hh.gaps ? 'Gaps mean the board was off or lost Wi-Fi, and temperature during that time is unknown. ' : '') + (d.errors ? 'Sensor errors usually mean a loose probe cable. ' : '') + (!Hh.restarts && !Hh.gaps && !d.errors ? 'No gaps, restarts or sensor errors in this window.' : '') + '</p>';

  $('tbody').innerHTML = d.inWin.slice(-300).reverse().map(p => '<tr><td>' + dmy(p.t) + ' ' + hhmm(p.t) + '</td><td>' + (p.v === null ? '–' : p.v.toFixed(2)) + '</td><td>' + (p.rssi === null ? '–' : p.rssi) + '</td><td>' + (p.v === null ? 'Sensor error' : stateText(p.v, P.lo, P.hi)) + '</td></tr>').join('');
  $('foot').textContent = 'Times are Indian Standard Time. Figures weight each reading by the time it covers, so quick restarts do not count twice. ' + (MODE === 'live' ? 'Last loaded ' + hhmm(LAST_LOAD + 19800000) + '.' : '');
}

/* ---------------- wiring ---------------- */
async function reload(){
  await loadData();
  nowRef = MODE === 'live' ? Date.now() + 19800000 : ALL.reduce((a, r) => Math.max(a, r.t), 0) + MIN;
  renderAll();
}
$('dev').addEventListener('change', e => { state.dev = e.target.value; renderAll(); });
$('profile').addEventListener('change', e => { store.set('profile.' + state.dev, e.target.value); renderAll(); });
['lo', 'hi'].forEach(id => $(id).addEventListener('input', () => {
  const lo = parseFloat($('lo').value), hi = parseFloat($('hi').value);
  if (!isNaN(lo) && !isNaN(hi) && hi > lo){ store.set('lo.' + state.dev, lo); store.set('hi.' + state.dev, hi); renderAll(); }
}));
document.querySelectorAll('.seg button[data-w]').forEach(b => b.addEventListener('click', () => { state.win = b.dataset.w; store.set('win', state.win); renderAll(); }));
$('dv-line').addEventListener('click', () => { state.dview = 'line'; store.set('dview', 'line'); renderAll(); });
$('dv-list').addEventListener('click', () => { state.dview = 'list'; store.set('dview', 'list'); renderAll(); });
$('scenePick').addEventListener('change', e => { store.set('scene', e.target.value); renderAll(); });
$('openSettings').addEventListener('click', () => { $('sheet').hidden = false; $('closeSettings').focus(); });
$('closeSettings').addEventListener('click', () => { $('sheet').hidden = true; $('openSettings').focus(); });
$('sheet').addEventListener('click', e => { if (e.target === $('sheet')) $('sheet').hidden = true; });
document.addEventListener('keydown', e => { if (e.key === 'Escape') $('sheet').hidden = true; });
$('refresh').addEventListener('click', reload);
$('saveCfg').addEventListener('click', () => {
  store.set('csv', $('csvUrl').value.trim()); store.set('start', $('startFrom').value);
  store.set('watts', $('watts').value || '350'); store.set('tariff', $('tariff').value || '8');
  $('sheet').hidden = true; reload();
});
$('csvUrl').value = store.get('csv', ''); $('startFrom').value = store.get('start', '');
$('watts').value = store.get('watts', '350'); $('tariff').value = store.get('tariff', '8');
$('car').addEventListener('scroll', () => {
  const c = $('car'), i = Math.round(c.scrollLeft / Math.max(1, c.clientWidth));
  document.querySelectorAll('#dots i').forEach((x, k) => x.classList.toggle('on', k === i));
});
document.addEventListener('click', e => { const a = e.target.closest('[data-jump]'); if (a){ const t = $(a.dataset.jump); if (t) t.scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'start'}); } });
let rt; window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(renderAll, 140); });
let left = CONFIG.REFRESH_SECONDS;
setInterval(() => {
  if (document.hidden || MODE !== 'live') return;
  left--; const c = $('countdown'); if (c) c.textContent = 'Refresh in ' + Math.max(left, 0) + ' s';
  if (left <= 0){ left = CONFIG.REFRESH_SECONDS; reload(); }
}, 1000);
document.addEventListener('visibilitychange', () => { if (!document.hidden && MODE === 'live') reload(); });
fxSize(); reload();
</script>
</body>
</html>
